# Anthropic credentials — set one of these.
# ANTHROPIC_API_KEY is a console API key (https://console.anthropic.com/).
# ANTHROPIC_AUTH_TOKEN is a Bearer token (Claude Code / OAuth / some gateways).
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# Optional: Exa API key for higher rate limits on web_search_exa / web_fetch_exa.
# Without it, those tools use Exa's hosted MCP (https://mcp.exa.ai/mcp) anonymously.
# Get a key at https://dashboard.exa.ai/api-keys
# EXA_API_KEY=

# Model to use (any Claude model id). Defaults to claude-opus-4-8.
MODEL=claude-opus-4-8

# Optional: point at an Anthropic-compatible third-party endpoint
# (gateway/proxy, e.g. LiteLLM, Cloudflare AI Gateway, a corporate proxy).
# The endpoint MUST speak the Anthropic /v1/messages API. Leave unset to use
# the default Anthropic API. The underlying SDK also honors ANTHROPIC_BASE_URL.
# ANTHROPIC_BASE_URL=https://gateway.example.com/anthropic

# Maximum recent messages sent back to the model for context.
# Full frontend session messages are still persisted in .sessions.json.
MAX_MODEL_MESSAGES=100

# Max ms to wait for the next chunk from the model before treating the request
# as timed out. A long generation that keeps streaming is NOT interrupted; only
# a total silence for this long trips the timeout and notifies the user to
# check the API. Default: 60000 (60s).
# MODEL_TIMEOUT_MS=60000

# Optional: change where persisted sessions are stored.
# SESSION_STORE_FILE=.sessions.json

# Optional: workspace folder for read_file/write_file tools.
# WORKSPACE=./workspace

# Optional: GitHub token for the skill market (higher rate limits when
# browsing owner/repo catalogs). Also honored as GH_TOKEN.
# GITHUB_TOKEN=

# Port for the server.
PORT=3000
