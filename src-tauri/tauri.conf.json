{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dagent",
  "version": "0.1.0",
  "identifier": "io.dagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Dagent", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 620, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "installMode": "currentUser" } },
    "icon": []
  }
}
